// Prisma schema for PawHaven Pet Adoption & Supplies
// Uses PostgreSQL (Neon) for both local dev and production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ──────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  role         String   @default("MODERATOR") // ADMIN | MODERATOR
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Catalog ───────────────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String
  price          Float
  compareAtPrice Float?
  type           String         @default("SUPPLY") // PET | SUPPLY
  // Pet-specific fields
  breed          String?
  age            String?
  color          String?
  gender         String?
  vaccinated     Boolean?
  neutered       Boolean?
  // Supply-specific
  brand          String?
  // Common
  stock          Int            @default(1)
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media          ProductMedia[]
  featured       Boolean        @default(false)
  status         String         @default("ACTIVE") // ACTIVE | SOLD | ADOPTED | INACTIVE
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      String  // IMAGE | VIDEO
  order     Int     @default(0)
  isMain    Boolean @default(false)
}

// ─── Orders (from cart checkout) ───────────────────────────────
model Order {
  id            String   @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  customerLocation String?
  items         String   // JSON string of cart items
  total         Float
  status        String   @default("PENDING") // PENDING | CONFIRMED | SHIPPED | COMPLETED | CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Adoption Applications ─────────────────────────────────────
model AdoptionApplication {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String?
  location   String
  petType    String
  petColor   String?
  petAge     String?
  amount     Float?
  experience String?
  message    String?
  productId  String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | CONTACTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Site Settings (singleton) ─────────────────────────────────
model SiteSettings {
  id              String   @id @default("singleton")
  siteName        String   @default("PawHaven")
  siteTagline     String   @default("Where Every Pet Finds a Home")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("")
  accentColor     String   @default("")
  fontHeading     String   @default("geist")
  fontBody        String   @default("geist")
  borderRadius    String   @default("0.625rem")
  heroTitle       String   @default("Find Your New Best Friend")
  heroSubtitle    String   @default("Adopt a loving pet or shop premium supplies — all in one place.")
  heroImageUrl    String?
  heroCtaText     String   @default("Browse Pets")
  footerText      String   @default("© PawHaven. All rights reserved.")
  contactEmail    String   @default("orders@pawhaven.example")
  contactPhone    String?
  address         String?
  socialFacebook  String?
  socialTwitter   String?
  socialInstagram String?
  socialYoutube   String?
  showFeatured    Boolean  @default(true)
  showCategories  Boolean  @default(true)
  orderEmail      String   @default("orders@pawhaven.example")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}